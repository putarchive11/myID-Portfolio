---

// Teks halaman. Website kini hanya berbahasa Inggris: yang dirender hanya `en`.
// Versi `id` disimpan di kode sebagai cadangan bila suatu saat ingin dua bahasa lagi.
interface Props {
  id?: string
  en?: string
}

const { en } = Astro.props
const hasEnSlot = Astro.slots.has('en')
---

{hasEnSlot ? <slot name='en' /> : en}
