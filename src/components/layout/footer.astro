---
import { MailIcon, PhoneIcon, FileDownIcon } from 'lucide-react'

import { buttonVariants } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'

import { CONTACT, PROFILE } from '@/consts'

const socials = [
  { label: 'WhatsApp', href: CONTACT.whatsapp, icon: PhoneIcon, external: true },
  { label: 'Email', href: `mailto:${CONTACT.email}`, icon: MailIcon, external: false },
  { label: 'Portofolio PDF', href: PROFILE.portfolioPdf, icon: FileDownIcon, external: true }
]

const year = new Date().getFullYear()
---

<footer class='lg:px-10.5'>
  <div class='mx-auto max-w-4xl space-y-12 pb-12 lg:border-x xl:max-w-245'>
    <div class='flex items-center gap-3'>
      <Separator className='flex-1' />
      <div class='flex items-center gap-3'>
        {
          socials.map(social => (
            <a
              href={social.href}
              target={social.external ? '_blank' : undefined}
              rel={social.external ? 'noopener noreferrer' : undefined}
              aria-label={social.label}
              class={buttonVariants({
                variant: 'outline',
                size: 'icon',
                className: 'hover:bg-muted/5 hover:text-accent min-w-10 rounded-md'
              })}
            >
              <social.icon className='size-4' />
            </a>
          ))
        }
      </div>
      <Separator className='flex-1' />
    </div>

    <div class='mb-8 flex items-center justify-center gap-5 text-center max-lg:hidden xl:ml-8'>
      <p class='text-muted-foreground'>Terima kasih sudah berkunjung</p>
      <img src='/images/footer/tree-seal.webp' alt='Segel' class='size-25' />
      <p class='text-muted-foreground'>Mari berkarya bersama</p>
    </div>

    <div class='space-y-1 text-center'>
      <p class='text-accent [font-family:var(--font-handwritten)] text-3xl'>Barakallahu fiikum</p>
      <p class='text-xs'>© {year} {PROFILE.fullName}</p>
    </div>
  </div>
</footer>
