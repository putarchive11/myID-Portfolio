---
import { cn } from '@/lib/utils'

import { toBilingual, type Bilingual } from '@/lib/i18n'

interface Props {
  text: string | Bilingual

  /** Versi bahasa Inggris (bila `text` berupa string). */
  en?: string
  class?: string
}

import T from '@/components/i18n/T.astro'

const { text, en, class: className } = Astro.props
const label = typeof text === 'string' ? { id: text, en: en ?? text } : toBilingual(text)
---

<p class={cn('text-accent text-[22px] font-medium italic', className)}>// <T id={label.id} en={label.en} /></p>
