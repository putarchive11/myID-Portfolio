---
import { ArrowRightIcon } from 'lucide-react'

import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card } from '@/components/ui/card'

import T from '@/components/i18n/T.astro'

import { cn } from '@/lib/utils'
import { caseText, type CaseStudyMetadata } from '@/lib/case-studies'
import { i18nAttrs } from '@/lib/i18n'

interface Props {
  caseStudy: CaseStudyMetadata
  variant?: 'hero' | 'grid'
  imageSide?: 'left' | 'right'
}

const { caseStudy, variant = 'grid', imageSide = 'right' } = Astro.props
const title = caseText(caseStudy, 'title')
const description = caseText(caseStudy, 'description')
const organisation = caseText(caseStudy, 'organisation')
const role = caseText(caseStudy, 'role')
const duration = caseText(caseStudy, 'duration')
const period = caseText(caseStudy, 'period')
const isHero = variant === 'hero'
---

<a href={`/case-study/${caseStudy.slug}`} class='block h-full no-underline'>
  <Card
    className={cn(
      'group ring-border h-full gap-0 overflow-hidden rounded-[24px] p-0 shadow-lg transition-all duration-300',
      isHero && (imageSide === 'left' ? 'md:flex-row-reverse' : 'md:flex-row')
    )}
  >
    <div class={cn('order-2 flex flex-col justify-between gap-3 p-4 sm:p-6', isHero ? 'sm:py-8 md:order-0' : '')}>
      <div class='space-y-3'>
        <h3 class='line-clamp-2 text-xl font-medium md:text-2xl lg:text-[26px]'><T id={title.id} en={title.en} /></h3>
        <div class='flex items-center gap-2.5'>
          {
            caseStudy.duration && (
              <Badge variant='outline' className='rounded-full border-(--background-darker) bg-(--background-darker)'>
                <T id={duration.id} en={duration.en} />
              </Badge>
            )
          }
          {
            period.id && (
              <Badge variant='outline' className='rounded-full border-(--background-darker) bg-(--background-darker)'>
                <T id={period.id} en={period.en} />
              </Badge>
            )
          }
        </div>
        <p class='text-muted-foreground line-clamp-3 text-base'><T id={description.id} en={description.en} /></p>
      </div>

      <div class='flex items-center justify-between gap-2 border-t pt-3'>
        {
          caseStudy.organisation && (
            <div class='flex items-center gap-3'>
              {caseStudy.logo && (
                <div class='bg-accent/10 text-accent flex size-10.5 shrink-0 items-center justify-center rounded-md text-sm font-semibold'>
                  {caseStudy.logo}
                </div>
              )}
              <div class='text-base'>
                <p class='text-foreground font-medium'>
                  <T id={organisation.id} en={organisation.en} />
                </p>
                {role.id && (
                  <p class='text-muted-foreground'>
                    <T id={role.id} en={role.en} />
                  </p>
                )}
              </div>
            </div>
          )
        }
        <div
          class='bg-card dark:border-accent-foreground/10 flex size-11 items-center justify-center rounded-full border shadow-md'
        >
          <Button
            size='icon'
            variant='outline'
            className='hover:bg-accent dark:hover:bg-accent bg-accent dark:bg-accent text-background hover:text-background dark:text-accent-foreground border-accent size-7 shrink-0 overflow-hidden rounded-full'
          >
            <span class='relative block size-4'>
              <ArrowRightIcon
                className='absolute inset-0 size-4 -rotate-45 transition-transform duration-400 ease-in-out group-hover:translate-x-5 group-hover:-translate-y-5'
              />
              <ArrowRightIcon
                className='absolute inset-0 size-4 -translate-x-5 translate-y-5 -rotate-45 transition-transform duration-400 ease-in-out group-hover:translate-x-0 group-hover:translate-y-0'
              />
            </span>
            <span class='sr-only'><T id={`Baca selengkapnya: ${title.id}`} en={`Read more: ${title.en}`} /></span>
          </Button>
        </div>
      </div>
    </div>

    {
      caseStudy.image && (
        <div class={cn('relative order-1 w-full overflow-hidden', isHero ? 'md:order-0 md:max-w-1/2' : '')}>
          <img
            src={caseStudy.image}
            {...i18nAttrs({ alt: title })}
            class={cn(
              'w-full object-cover transition-all duration-300 group-hover:scale-105',
              isHero ? 'h-full max-h-81' : 'h-68'
            )}
          />
        </div>
      )
    }
  </Card>
</a>
