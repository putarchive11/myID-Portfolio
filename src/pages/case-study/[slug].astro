---
import { render } from 'astro:content'
import { ChevronLeftIcon } from 'lucide-react'

import Layout from '@/layouts/Layout.astro'
import { Button } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import FeaturedWorks from '@/components/shared/featured-works/featured-works.astro'
import ReadingProgressPill from '@/components/case-study/reading-progress-pill'
import { mdxComponents } from '@/components/case-study/mdx-components'
import T from '@/components/i18n/T.astro'

import UsersGroupIcon from '@/assets/svg/users-group-icon'
import CalendarIcon from '@/assets/svg/calendar-icon'
import UserCircleIcon from '@/assets/svg/user-circle-icon'
import RulerPenIcon from '@/assets/svg/ruler-pen-icon'

import { caseText, caseTools, getAllCaseStudies, getCaseStudies, getEnglishEntry } from '@/lib/case-studies'
import { i18nAttrs } from '@/lib/i18n'
import { PROFILE } from '@/consts'

export async function getStaticPaths() {
  const caseStudies = await getAllCaseStudies()

  return caseStudies.map(entry => ({
    params: { slug: entry.data.slug },
    props: entry
  }))
}

const caseStudy = Astro.props
const { data } = caseStudy

const { Content, headings } = await render(caseStudy)

// Versi bahasa Inggris (src/content/case-studies-en). Jika belum ada, versi Indonesia dipakai.
const englishEntry = await getEnglishEntry(data.slug)
const english = englishEntry ? await render(englishEntry) : null
const ContentEn = english?.Content
const headingsEn = english?.headings ?? []

const item = { ...data, en: englishEntry?.data }
const title = caseText(item, 'title')
const tools = caseTools(item)

const allCaseStudies = await getCaseStudies()
const otherCaseStudies = allCaseStudies.filter(item => item.slug !== data.slug).slice(0, 2)

const heroImageSrc = data.heroImage ?? data.image

const metaItems = [
  { label: { id: 'Organisasi', en: 'Organization' }, value: caseText(item, 'organisation'), icon: UsersGroupIcon },
  { label: { id: 'Peran', en: 'Role' }, value: caseText(item, 'role'), icon: UserCircleIcon },
  {
    label: { id: 'Waktu', en: 'Date' },
    value: data.period ? caseText(item, 'period') : caseText(item, 'duration'),
    icon: CalendarIcon
  }
].filter(meta => meta.value.id)

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: title.en,
      description: caseText(item, 'description').en,
      author: { '@type': 'Person', name: PROFILE.name },
      keywords: data.tools?.join(', '),
      articleSection: data.organisation
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
        { '@type': 'ListItem', position: 2, name: title.en, item: `/case-study/${data.slug}/` }
      ]
    }
  ]
}
---

<Layout title={title.en} description={caseText(item, 'description').en} type='article' schema={schema}>
  <ReadingProgressPill
    client:load
    headings={headingsEn.length > 0 ? headingsEn : headings}
    contentId='case-study-content'
  />

  <section class='mx-auto space-y-8 border-b px-4 pb-8 text-center max-sm:pt-20 sm:px-6 sm:py-24 lg:px-10.5'>
    <a
      href='/'
      class='text-muted-foreground hover:text-foreground mr-auto flex items-center gap-2 text-base no-underline'
    >
      <Button
        size='icon-xs'
        variant='outline'
        className='text-foreground size-6 border-transparent bg-(--background-darker) hover:bg-(--background-darker) dark:border-transparent'
      >
        <ChevronLeftIcon className='size-4' />
      </Button>
      <T id='Kembali ke beranda' en='Back to home' />
    </a>

    <h1 class='text-card-foreground text-3xl leading-[1.2] font-semibold sm:text-4xl md:text-5xl lg:text-[64px]'>
      <T id={title.id} en={title.en} />
    </h1>

    {
      heroImageSrc && (
        <div class='bg-card relative w-full overflow-hidden rounded-3xl p-2 sm:p-3 dark:bg-white/10'>
          <div class='bg-background relative size-full overflow-hidden rounded-2xl'>
            <img src={heroImageSrc} {...i18nAttrs({ alt: title })} class='object-cover' />
          </div>
        </div>
      )
    }

    {
      metaItems.length > 0 && (
        <div class='mx-auto grid max-w-xl justify-start gap-4 pt-16 text-left sm:grid-cols-2 sm:justify-center'>
          {metaItems.map(meta => (
            <div class='flex w-fit items-center gap-3'>
              <div class='flex size-13.5 shrink-0 items-center justify-center rounded-xl bg-(--background-darker)'>
                <meta.icon className='text-accent size-8' />
              </div>
              <div>
                <p class='text-muted-foreground text-xs tracking-wide uppercase'>
                  <T id={meta.label.id} en={meta.label.en} />
                </p>
                <p class='font-medium'>
                  <T id={meta.value.id} en={meta.value.en} />
                </p>
              </div>
            </div>
          ))}

          {data.tools && data.tools.length > 0 && (
            <div class='flex items-center gap-3 max-sm:justify-start'>
              <div class='flex size-13.5 shrink-0 items-center justify-center rounded-xl bg-(--background-darker)'>
                <RulerPenIcon className='text-accent size-8' />
              </div>
              <div>
                <p class='text-muted-foreground text-xs tracking-wide uppercase'>
                  <T id='Cakupan' en='Scope' />
                </p>
                <div class='mt-1 flex flex-wrap gap-1.5'>
                  {tools.map(tool => (
                    <Badge variant='secondary' className='text-foreground bg-(--background-darker) font-normal'>
                      <T id={tool.id} en={tool.en} />
                    </Badge>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>
      )
    }

    <div id='case-study-content' class='mt-16 text-left'>
      {ContentEn ? <ContentEn components={mdxComponents} /> : <Content components={mdxComponents} />}
    </div>
  </section>

  <FeaturedWorks
    caseStudies={otherCaseStudies}
    id='other-works'
    eyebrow={{ id: 'Karya lain', en: 'More work' }}
    layout='vertical'
    title={{ id: 'Lihat karya saya yang lain', en: 'See more of my work' }}
    showBorder={false}
  />
</Layout>
