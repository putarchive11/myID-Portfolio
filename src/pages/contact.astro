---
import Layout from '@/layouts/Layout.astro'
import ContactHero from '@/components/contact/contact-hero/contact-hero'
import FeaturedWorks from '@/components/shared/featured-works/featured-works.astro'
import Services from '@/components/shared/services/services'

import { getCaseStudies } from '@/lib/case-studies'
import { CONTACT, PROFILE } from '@/consts'

const caseStudies = await getCaseStudies(2)

const pageTitle = 'Kontak'
const pageDescription = `Hubungi ${PROFILE.name} lewat WhatsApp (${CONTACT.phoneDisplay}) atau email (${CONTACT.email}).`

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      name: pageTitle,
      description: pageDescription
    },
    {
      '@type': 'Person',
      name: PROFILE.fullName,
      jobTitle: PROFILE.title,
      email: CONTACT.email,
      telephone: CONTACT.phoneDisplay
    }
  ]
}
---

<Layout title={pageTitle} description={pageDescription} schema={schema}>
  <ContactHero client:load />
  <FeaturedWorks caseStudies={caseStudies} layout='vertical' title='Lihat beberapa karya saya' />
  <Services client:visible />
</Layout>
