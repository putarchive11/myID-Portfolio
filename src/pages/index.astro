---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/home/hero/hero.astro'
import About from '@/components/home/about/about.astro'
import WorkShowcase from '@/components/shared/featured-works/work-showcase.astro'
import WorkFolders from '@/components/shared/featured-works/work-folders'
import Experience from '@/components/home/experience/experience.astro'
import Services from '@/components/shared/services/services'
import HireMe from '@/components/home/hire-me/hire-me.astro'

import { getCaseStudies } from '@/lib/case-studies'
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '@/consts'

const caseStudies = await getCaseStudies()

const pageKeywords = 'Putra Rayhan Assidiqi, web builder, desainer, landing page, desain kemasan, poster acara'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: PROFILE.name,
      description: SITE_DESCRIPTION,
      inLanguage: 'id-ID'
    },
    {
      '@type': 'Person',
      name: PROFILE.fullName,
      jobTitle: PROFILE.title
    }
  ]
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={pageKeywords} schema={schema}>
  <Hero />
  <About />
  <WorkShowcase
    caseStudies={caseStudies.filter(item => item.kategori === 'web')}
    eyebrow={{ id: 'Karya web', en: 'Web work' }}
    title={{ id: 'Website dan aplikasi yang saya bangun', en: 'Websites and apps I have built' }}
  />
  <WorkFolders
    client:visible
    caseStudies={caseStudies.filter(item => item.kategori !== 'web')}
    id='karya-desain'
    eyebrow={{ id: 'Eksekusi Proyek', en: 'Project Execution' }}
    title={{
      id: 'Menghidupkan Ide: Dari Produk Fisik Hingga Gelaran Acara',
      en: 'Bringing Ideas to Life: From Physical Products to Live Events'
    }}
  />
  <Experience />
  <Services client:visible />
  <HireMe />
</Layout>
