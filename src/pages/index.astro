---
import Layout from '@/layouts/Layout.astro'
import Hero from '@/components/home/hero/hero.astro'
import About from '@/components/home/about/about.astro'
import FeaturedWorks from '@/components/shared/featured-works/featured-works.astro'
import Experience from '@/components/home/experience/experience.astro'
import Services from '@/components/shared/services/services'
import HireMe from '@/components/home/hire-me/hire-me.astro'

import { getCaseStudies } from '@/lib/case-studies'
import { PROFILE, SITE_DESCRIPTION, SITE_TITLE } from '@/consts'

const caseStudies = await getCaseStudies()

const pageKeywords = 'Putra Rayhan Assidiqi, web builder, admin e-commerce, landing page, desain kemasan, poster acara'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: PROFILE.name,
      description: SITE_DESCRIPTION,
      inLanguage: 'id-ID'
    },
    {
      '@type': 'Person',
      name: PROFILE.fullName,
      jobTitle: PROFILE.title
    }
  ]
}
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={pageKeywords} schema={schema}>
  <Hero />
  <About />
  <FeaturedWorks caseStudies={caseStudies} title='Proyek dan acara yang pernah saya kerjakan' />
  <Experience />
  <Services client:visible />
  <HireMe />
</Layout>
